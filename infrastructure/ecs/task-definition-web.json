{
  "family": "banking-ai-platform-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/banking-ai-platform-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/banking-ai-platform-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "banking-ai-platform-gateway",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/banking-ai-platform-staging-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "ENVIRONMENT", "value": "production"},
        {"name": "DEBUG", "value": "false"},
        {"name": "POSTGRES_PORT", "value": "5432"}
      ],
      "secrets": [
        {"name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:banking-ai-platform/staging/app-secrets:DATABASE_URL::"},
        {"name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:banking-ai-platform/staging/app-secrets:REDIS_URL::"},
        {"name": "SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:banking-ai-platform/staging/app-secrets:SECRET_KEY::"},
        {"name": "GEMINI_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:banking-ai-platform/staging/app-secrets:GEMINI_API_KEY::"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/banking-ai-platform-production",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "gateway"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/api/v1/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}
